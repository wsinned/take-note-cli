{
  "tasks": {
    "start": "deno run --allow-run --allow-read --allow-write --allow-env --allow-sys take-note.ts weekly --notesFolder ~/tmp/notes --when thisWeek",
    "startNext": "deno run --allow-run --allow-read --allow-write --allow-env --allow-sys take-note.ts weekly --notesFolder ~/tmp/notes --when nextWeek",
    "startLast": "deno run --allow-run --allow-read --allow-write --allow-env --allow-sys take-note.ts weekly --notesFolder ~/tmp/notes --when lastWeek",
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys --allow-run",
    "build": "deno compile --no-check --output output/take-note --allow-run --allow-read --allow-write --allow-env --allow-sys take-note.ts",
    "build:all": "deno compile --no-check --output output/take-note --allow-run --allow-read --allow-write --allow-env --allow-sys take-note.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.16",
    "@std/fs": "jsr:@std/fs@^1.0.16",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@stricli/auto-complete": "npm:@stricli/auto-complete@^1.2.0",
    "@stricli/core": "npm:@stricli/core@^1.2.0",
    "date-fn": "npm:date-fn@^0.0.2",
    "date-fns": "npm:date-fns@^4.1.0"
  },
  "version": "1.0.0"
}
