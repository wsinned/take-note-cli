{
	"name": "Deno",
	"image": "devcon-deno-dx",
	"containerEnv": {
		"HOME": "/var/home/devuser",
		"TZ": "GMT",
		"USER": "devuser",
		"DOTFILES_REPOSITORY": "/var/home/devuser/dotfiles"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"justjavac.vscode-deno-extensionpack"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "fish",
				"terminal.integrated.fontFamily": "MesloLGL Nerd Font",
				"dotfiles.repository": "wsinned/container-dotfiles",
				"dotfiles.targetPath": "~/dotfiles"
			}
		}
	},
	"remoteUser": "devuser"
}
